# ---- Telegram --------------------------------------------------------------
# Mode: "bot" (HTTP Bot API) or "account" (MTProto user account)
LIBERTATI_TELEGRAM_MODE=bot

# Bot mode: token from @BotFather
LIBERTATI_BOT_TOKEN=123456:your-bot-token

# Account mode: credentials from https://my.telegram.org/apps
LIBERTATI_TG_API_ID=0
LIBERTATI_TG_API_HASH=
# Telethon session name (a <name>.session file is created next to the app)
LIBERTATI_TG_SESSION=libertati

# ---- OpenAI ----------------------------------------------------------------
LIBERTATI_OPENAI_API_KEY=sk-...
# Optional: point at any OpenAI-compatible endpoint
# LIBERTATI_OPENAI_BASE_URL=https://api.openai.com/v1
LIBERTATI_OPENAI_MODEL=gpt-4o-mini
LIBERTATI_OPENAI_TEMPERATURE=1.0

# ---- Storage ---------------------------------------------------------------
LIBERTATI_DB_PATH=data/libertati.db
LIBERTATI_MEMORY_DIR=memory

# ---- Behaviour -------------------------------------------------------------
LIBERTATI_RESPOND_TO_ALL=true
LIBERTATI_HEARTBEAT_ENABLED=true
LIBERTATI_DREAM_ENABLED=true
LIBERTATI_NEWS_REFRESH_HOURS=6
# Comma-separated RSS/Atom feeds
# LIBERTATI_NEWS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://hnrss.org/frontpage

# ---- Persona ---------------------------------------------------------------
LIBERTATI_BOT_FULL_NAME=Ana Tati
LIBERTATI_BOT_HANDLE=@libertati
LIBERTATI_BOT_USERNAME=@libertati_bot

# ---- Logging ---------------------------------------------------------------
LIBERTATI_LOG_LEVEL=INFO
