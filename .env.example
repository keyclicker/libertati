# ---- Telegram --------------------------------------------------------------
# Bot token from @BotFather
LIBERTATI_BOT_TOKEN=123456:your-bot-token

# ---- OpenAI ----------------------------------------------------------------
LIBERTATI_OPENAI_API_KEY=sk-...
# Optional: point at any OpenAI-compatible endpoint
# LIBERTATI_OPENAI_BASE_URL=https://api.openai.com/v1
LIBERTATI_OPENAI_MODEL=gpt-4o-mini
LIBERTATI_OPENAI_TEMPERATURE=1.0

# ---- Storage ---------------------------------------------------------------
LIBERTATI_DB_PATH=data/libertati.db
LIBERTATI_MEMORY_DIR=memory
# Reply context: the reply thread (chars) plus a smaller window of recent chat
# messages, so the bot also sees what's happening now, not only the thread.
LIBERTATI_MAX_THREAD_CHARS=5000
LIBERTATI_RECENT_CONTEXT_MESSAGES=20
LIBERTATI_RECENT_CONTEXT_CHARS=1200
# Memory files are capped on disk (oldest lines trimmed) and clipped per-file
# when injected into the prompt — keeps token cost bounded as notes grow.
LIBERTATI_MEMORY_MAX_FILE_CHARS=4000
LIBERTATI_MEMORY_CONTEXT_FILE_CHARS=700

# ---- Behaviour -------------------------------------------------------------
LIBERTATI_RESPOND_TO_ALL=true
# In groups: always reply when addressed (mentioned / replied-to); otherwise
# reply to ambient chatter only this fraction of the time (0 = only when addressed).
LIBERTATI_GROUP_REPLY_CHANCE=0.05
# Human-like pause before sending, scaled by reply length and capped (seconds).
LIBERTATI_TYPING_DELAY_ENABLED=true
LIBERTATI_TYPING_DELAY_MAX_SECONDS=5.0
LIBERTATI_HEARTBEAT_ENABLED=true
LIBERTATI_DREAM_ENABLED=true
LIBERTATI_NEWS_REFRESH_HOURS=6
# Comma-separated RSS/Atom feeds
# LIBERTATI_NEWS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://hnrss.org/frontpage

# Restrict which chats the bot proactively talks in (ids and/or @usernames).
# Empty = talk everywhere. It still logs messages it sees for memory/history.
# LIBERTATI_ALLOWED_CHATS=@mygroup,-1001234567890

# ---- Browsing (reading public channels via the t.me/s/ web preview) --------
# When enabled, the bot randomly reads the configured public channels a few
# times a day, notes interesting things to memory/reading.md, and may bring
# them up. Only public @channels with the web preview enabled are readable.
LIBERTATI_BROWSE_ENABLED=false
# Required for browsing: which public channels to read.
# LIBERTATI_BROWSE_CHANNELS=@durov,@somenewschannel
LIBERTATI_BROWSE_TIMES_PER_DAY=3
LIBERTATI_BROWSE_READ_LIMIT=15

# ---- Persona ---------------------------------------------------------------
LIBERTATI_BOT_FULL_NAME=Ana Tati
LIBERTATI_BOT_HANDLE=@libertati
LIBERTATI_BOT_USERNAME=@libertati_bot

# ---- Logging / observability -----------------------------------------------
LIBERTATI_LOG_LEVEL=INFO
# Structured behavioral telemetry (JSONL): every turn's LLM calls, tool calls,
# memory writes and messages, correlated by turn id. Great for debugging behavior.
LIBERTATI_EVENT_LOG_ENABLED=true
LIBERTATI_EVENT_LOG_PATH=data/events.jsonl
# Log message/tool text (truncated). Set false to record only lengths/shapes.
LIBERTATI_LOG_MESSAGE_CONTENT=true
LIBERTATI_LOG_CONTENT_MAX_CHARS=300
