# Secrets only — copy to .env and fill in. Non-secret settings live in
# settings.toml (any of them can also be overridden as LIBERTATI_* here).

# Telegram bot token from @BotFather.
LIBERTATI_BOT_TOKEN=

# API key for the LLM endpoint (OpenAI, OpenRouter, …).
LIBERTATI_API_KEY=

# Key for the media (vision / speech-to-text) endpoint, when it is a
# different provider than the one above. Empty reuses LIBERTATI_API_KEY.
LIBERTATI_MEDIA_API_KEY=
