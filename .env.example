# Secrets only — every other setting lives in config.toml.
# Copy to .env (gitignored) and fill in. LIBERTATI_* env vars override
# config.toml, so anything can also be set here or in the environment.

# Telegram bot token from @BotFather
LIBERTATI_BOT_TOKEN=123456:your-bot-token

# OpenAI (or compatible) API key
LIBERTATI_OPENAI_API_KEY=sk-...
